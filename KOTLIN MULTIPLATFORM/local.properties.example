# Copy this file to local.properties and fill in your Supabase project values.
# local.properties is git-ignored and must never be committed.
#
# Find these values in your Supabase project dashboard:
#   Settings → API → Project URL  (SUPABASE_URL)
#   Settings → API → anon / public key  (SUPABASE_ANON_KEY)
#
# Environment variables (SUPABASE_URL, SUPABASE_ANON_KEY) override these values
# when set, so CI pipelines can supply credentials without a local.properties file.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
